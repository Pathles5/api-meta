{
    "name":  "srvc-ig-mimi2-5-free",
    "version":  "0.1.0",
    "description":  "Instagram REST API - Meta API integration and webhook handling",
    "type":  "module",
    "main":  "src/index.js",
    "scripts":  {
                    "start":  "node src/server.js",
                    "dev":  "node --watch src/server.js",
                    "test":  "node --test tests/**/*.test.js",
                    "test:watch":  "node --test --watch tests/**/*.test.js",
                    "lint":  "eslint src/ tests/ infra/",
                    "lint:fix":  "eslint src/ tests/ infra/ --fix",
                    "db:start":  "java -Djava.library.path=./tools/dynamodb-local/DynamoDBLocal_lib -jar ./tools/dynamodb-local/DynamoDBLocal.jar -sharedDb -port 8000",
                    "db:setup":  "node scripts/setup-table.js",
                    "cdk":  "cdk"
                },
    "keywords":  [
                     "instagram",
                     "api",
                     "rest",
                     "meta",
                     "webhooks"
                 ],
    "author":  "",
    "license":  "ISC",
    "devEngines":  {
                       "packageManager":  {
                                              "name":  "pnpm",
                                              "version":  "^11.5.0",
                                              "onFail":  "download"
                                          }
                   },
    "engines":  {
                    "node":  "\u003e=24.0.0"
                },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "aws-cdk":  "^2.1125.0",
                            "aws-cdk-lib":  "^2.257.0",
                            "constructs":  "^10.6.0",
                            "eslint":  "^10.4.1"
                        },
    "dependencies":  {
                         "@aws-sdk/client-dynamodb":  "^3.1057.0",
                         "@aws-sdk/lib-dynamodb":  "^3.1057.0",
                         "@vendia/serverless-express":  "^4.12.6",
                         "dotenv":  "^17.4.2",
                         "express":  "^5.2.1",
                         "pino":  "^10.3.1"
                     }
}