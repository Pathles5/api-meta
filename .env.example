# Meta API Configuration
# Get your access token from https://developers.facebook.com/
META_ACCESS_TOKEN=your_access_token_here

# Instagram Business Account ID
# Get it from: GET /me/accounts?fields=instagram_business_account
META_IG_USER_ID=your_ig_user_id_here

# Authentication
# Used by clients to access the API via X-API-Key header
AUTH_API_KEY=your_api_key_here

# Application
APP_PORT=3000
NODE_ENV=development
APP_RATE_LIMIT_WINDOW_MS=60000
APP_RATE_LIMIT_MAX=100
APP_LOG_LEVEL=info

# AWS Configuration
AWS_REGION=eu-west-1

# DynamoDB
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_TABLE_NAME=ig-posts
DYNAMODB_POST_TTL_DAYS=90

# Post Verification
POST_VERIFICATION_HOURS=24

# Webhooks (Meta App Secret for HMAC verification)
# Get it from: https://developers.facebook.com/ > Your App > Settings > Basic
META_APP_SECRET=your_app_secret_here

# Webhook verification token (you define this, then set it in Meta's webhook config)
META_VERIFY_TOKEN=your_verify_token_here

# Entorno (dev, pre, int, pro)
IG_ENV=pre
